{
  "name": "dewax-geo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Asystent Wiertacza GSHP - raport geologiczny dla dolnych zrodel pomp ciepla na podstawie danych CBDG PGI-PIB",
  "scripts": {
    "dev": "vite",
