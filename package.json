  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@netlify/vite-plugin": "^2.12.9",
    "@types/leaflet": "^1.9.21",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
